rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // SilverHands rules for users, listings, and messages
    match /users/{userId} {
      allow read, write: if true;
    }
    match /listings/{listingId} {
      allow read, write: if true;
    }
    match /messages/{messageId} {
      allow read, write: if true;
    }
    match /events/{eventId} {
      allow read, write: if true;
    }
  }
}
